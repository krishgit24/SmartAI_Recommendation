# --- Gateway (Developer A) - merge into the repo's .env.example. Never commit .env ---
LOG_LEVEL=INFO
DATABASE_PATH=smart_recommendation.db
MAX_RETRY_COUNT=3
KILL_SWITCH_DEFAULT=false
# protects POST /admin/kill-switch (header X-Admin-Token) - change it
ADMIN_TOKEN=change-me-local-only
# stub = built-in stub agent, real = app/agent/real_agent.py (Developer B)
AGENT_MODE=stub
AGENT_TIMEOUT_SECONDS=30
# reprocess | reject
DUPLICATE_PAYLOAD_POLICY=reprocess
CORS_ORIGINS=http://localhost:4200
